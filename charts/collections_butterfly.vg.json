
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Physical and digital public library collection holdings in Australia, 2020-21 to 2024-25.",

  "background": "#F8F5EF",

  "data": {
    "url": "data/library_collections_and_usage.csv",
    "format": {
      "type": "csv",
      "parse": {
        "physical_collection_items": "number",
        "digital_collection_items": "number"
      }
    }
  },

  "transform": [
    {
      "calculate": "datum.physical_collection_items / 1000000",
      "as": "physical_millions"
    },
    {
      "calculate": "datum.digital_collection_items / 1000000",
      "as": "digital_millions"
    }
  ],

  "spacing": 5,

  "hconcat": [
    {
      "width": 190,
      "height": 300,

      "title": {
        "text": "Physical Collections",
        "color": "#855536",
        "fontSize": 16
      },

      "mark": {
        "type": "bar",
        "color": "#855536",
        "size": 32
      },

      "encoding": {
        "y": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": "ascending",
          "axis": null
        },

        "x": {
          "field": "physical_millions",
          "type": "quantitative",
          "scale": {
            "domain": [0, 35],
            "reverse": true
          },
          "axis": {
            "title": "Millions of items",
            "values": [0, 10, 20, 30],
            "grid": false
          }
        },

        "tooltip": [
          {
            "field": "financial_year",
            "title": "Financial year"
          },
          {
            "field": "physical_collection_items",
            "type": "quantitative",
            "format": ",d",
            "title": "Physical items"
          }
        ]
      }
    },

    {
      "width": 65,
      "height": 300,

      "title": {
        "text": "Year",
        "fontSize": 16,
        "color": "#29332F"
      },

      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#29332F"
      },

      "encoding": {
        "y": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": "ascending",
          "axis": null
        },

        "x": {
          "datum": 0.5,
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          },
          "axis": null
        },

        "text": {
          "field": "financial_year",
          "type": "nominal"
        }
      }
    },

    {
      "width": 190,
      "height": 300,

      "title": {
        "text": "Digital Collections",
        "color": "#214D3F",
        "fontSize": 16
      },

      "mark": {
        "type": "bar",
        "color": "#214D3F",
        "size": 32
      },

      "encoding": {
        "y": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": "ascending",
          "axis": null
        },

        "x": {
          "field": "digital_millions",
          "type": "quantitative",
          "scale": {
            "domain": [0, 35]
          },
          "axis": {
            "title": "Millions of items",
            "values": [0, 10, 20, 30],
            "grid": false
          }
        },

        "tooltip": [
          {
            "field": "financial_year",
            "title": "Financial year"
          },
          {
            "field": "digital_collection_items",
            "type": "quantitative",
            "format": ",d",
            "title": "Digital items"
          }
        ]
      }
    }
  ],

  "resolve": {
    "scale": {
      "y": "shared",
      "x": "independent"
    }
  },

  "config": {
    "view": {
      "stroke": "transparent"
    },

    "axis": {
      "labelColor": "#29332F",
      "titleColor": "#29332F",
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}
